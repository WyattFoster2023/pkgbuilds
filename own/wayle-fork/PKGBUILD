# Maintainer: Wyatt Foster <wyattfosteredu@gmail.com>
# Wyatt's fork of wayle (custom-dropdown branch on top of v0.7.0).
pkgname=wayle-fork
pkgver=0.7.0.r1.gd3a76c3
pkgrel=1
pkgdesc='Wayle desktop shell, WyattFoster2023 fork (custom-dropdown module)'
arch=('x86_64')
url='https://github.com/WyattFoster2023/wayle'
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'gtksourceview5' 'libpulse' 'fftw' 'libpipewire' 'hicolor-icon-theme')
makedepends=('git' 'rust' 'cargo' 'pkgconf' 'clang')
optdepends=('pipewire-pulse: audio module' 'wireplumber: audio module' 'networkmanager: network module'
            'bluez: bluetooth module' 'upower: battery module' 'power-profiles-daemon: power profiles')
provides=('wayle')
conflicts=('wayle' 'wayle-bin' 'wayle-git' 'wayle-patched')
options=('!lto')
source=("$pkgname::git+https://github.com/WyattFoster2023/wayle.git#branch=custom-dropdown")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --match 'v*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p wayle -p wayle-settings
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/wayle target/release/wayle-settings -t "$pkgdir/usr/bin/"
  install -Dm644 resources/wayle.service -t "$pkgdir/usr/lib/systemd/user/"
  install -Dm644 resources/com.wayle.settings.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 resources/wayle-settings.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 resources/icons/hicolor/scalable/actions/*.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/actions/"
  target/release/wayle completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/wayle"
  target/release/wayle completions zsh  | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_wayle"
  target/release/wayle completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/wayle.fish"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
